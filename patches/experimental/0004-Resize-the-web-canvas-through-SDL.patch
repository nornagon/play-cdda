From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jeremy Rose <nornagon@nornagon.net>
Date: Sun, 30 Aug 2026 09:45:00 -0700
Subject: [PATCH] Resize the web canvas through SDL

---
 build-data/web/index.html | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/build-data/web/index.html b/build-data/web/index.html
--- a/build-data/web/index.html
+++ b/build-data/web/index.html
@@ -28,7 +28,7 @@
 
         height: 100%;
         overflow: hidden;
-        background-color: grey;
+        background-color: black;
       }
 
       canvas {
@@ -178,8 +178,6 @@
       style="
         width: 100%;
         height: 100%;
-        min-width: 640px;
-        min-height: 384px;
       "
       tabindex="-1"
     ></canvas>
@@ -193,6 +191,7 @@
 
       window.addEventListener("menuready", () => {
         menuReady = true;
+        window.dispatchEvent(new UIEvent("resize"));
         if (!tilesetDownloadActive) {
           loadingMessage.style.display = "none";
         }

