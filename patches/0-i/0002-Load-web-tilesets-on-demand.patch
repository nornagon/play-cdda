diff --git a/build-data/web/index.html b/build-data/web/index.html
index 08f29a4ba5..d5cd318273 100644
--- a/build-data/web/index.html
+++ b/build-data/web/index.html
@@ -188,11 +188,30 @@
       const canvas = document.getElementById("canvas");
       const loadingMessage = document.getElementById("loading-message");
       const settingsMenu = document.getElementById("settings-menu");
+      let menuReady = false;
+      let tilesetDownloadActive = false;
 
       window.addEventListener("menuready", () => {
-        loadingMessage.style.display = "none";
+        menuReady = true;
+        if (!tilesetDownloadActive) {
+          loadingMessage.style.display = "none";
+        }
       });
 
+      window.beginTilesetDownload = (id, size) => {
+        tilesetDownloadActive = true;
+        loadingMessage.style.display = "block";
+        const sizeInMb = (size / 1024 / 1024).toFixed(1);
+        loadingMessage.textContent = `Downloading ${id} (${sizeInMb} MB)...`;
+      };
+
+      window.endTilesetDownload = () => {
+        tilesetDownloadActive = false;
+        if (menuReady) {
+          loadingMessage.style.display = "none";
+        }
+      };
+
       document.getElementById("settings-gear").onclick = () => {
         if (settingsMenu.style.display === "none") {
           settingsMenu.style.display = "inherit";
@@ -264,6 +283,12 @@
         })(),
         setStatus: function (text) {
           if (text) {
+            const progress = /^Downloading data\.\.\. \((\d+)\/(\d+)\)$/.exec(text);
+            if (progress) {
+              const downloaded = Number(progress[1]) / 1024 / 1024;
+              const total = Number(progress[2]) / 1024 / 1024;
+              text = `Downloading data... (${downloaded.toFixed(1)}/${total.toFixed(1)} MB)`;
+            }
             loadingMessage.innerHTML = text;
           } else {
